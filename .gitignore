# --- Firmware 1 (pluto): upstream source is cloned fresh by setup.sh, not committed ---
firmware-1-pluto-usb-ethernet/src/

# --- Build outputs (regenerated by build_all.sh in either firmware dir) ---
**/output/*
!**/output/.gitkeep

# --- Vivado / Vitis regeneratable build products (keep real sources, drop caches) ---
**/*.runs/
**/*.gen/
**/*.ip_user_files/
**/*.sim/
**/*.cache/
**/ipcache/
**/.Xil/
**/vivado.jou
**/vivado.log
**/vivado_*.jou
**/vivado_*.log
**/vivado_*.str
**/*.backup.jou
**/*.backup.log
**/webtalk*.jou
**/webtalk*.log
**/*.dcp

# Vitis/xsct workspace metadata and build objects (fsbl/, gen_fsbl*.log) -
# scripts regenerate the whole fsbl/ workspace from scratch every build
**/fsbl/.metadata/
**/fsbl/system_top/
**/fsbl/fsbl/Debug/
**/fsbl/fsbl/.settings/
**/fsbl/fsbl_system/
**/fsbl_build/system_top/
**/fsbl_build/fsbl/Debug/
**/fsbl_build/fsbl/.settings/
**/fsbl_build/fsbl_system/
**/fsbl_build/.metadata/
**/*.jou
**/*_stdout.log
**/gen_fsbl*.log
**/create_project*.log
**/export_hw*.log
**/build.log
**/build_hdl.log
**/aie_primitive.json
**/axi_ad9361_delay.log
**/ip_upgrade*.log
**/ip_upgrade*.rpt
**/*_vivado.log

# Kept intentionally: the final bitstream and hardware platform export used
# by the FSBL/packaging steps are small and worth keeping for convenience -
# un-ignore them explicitly since they'd otherwise be caught by *.runs/ above.
!**/pluto.runs/impl_1/system_top.bit
!**/fmcomms2_zc706.runs/impl_1/system_top.bit

# --- OS / editor cruft ---
.DS_Store
*.swp
